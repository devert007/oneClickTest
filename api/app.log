 <BlankLine children=[]>,
 <Paragraph children=[<RawText children='| Strategy | Description | Example |'>,
 <LineBreak children='\n'>,
 <RawText children='|----------|-------------|---------|'>,
 <LineBreak children='\n'>,
 <RawText children='| '>,
 <StrongEmphasis children=[<RawText children='Oviparous'>]>,
 <RawText children=' | Lays eggs; embryos develop outside mother’s body. | Chickens, turtles. |'>,
 <LineBreak children='\n'>,
 <RawText children='| '>,
 <StrongEmphasis children=[<RawText children='Viviparous'>]>,
 <RawText children=(' | Gives birth to live young; embryos develop inside mother. | Humans, most '
 'mammals. |')>,
 <LineBreak children='\n'>,
 <RawText children='| '>,
 <StrongEmphasis children=[<RawText children='Ovoviviparous'>]>,
 <RawText children=(' | Eggs develop inside mother and hatch just before birth. | Some sharks, '
 'many reptiles. |')>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<StrongEmphasis children=[<RawText children='Key Fact:'>]>,
 <RawText children=' Sexual reproduction creates genetic variation through '>,
 <StrongEmphasis children=[<RawText children='meiosis'>]>,
 <RawText children=' (reduces chromosome number by half) and '>,
 <StrongEmphasis children=[<RawText children='genetic recombination'>]>,
 <RawText children=' (crossing‑over), which is essential for evolution.'>]>,
 <BlankLine children=[]>,
 <ThematicBreak children=[]>,
 <BlankLine children=[]>,
 <Heading children=[<RawText children='5. Human Reproduction – A Closer Look'>]>,
 <BlankLine children=[]>,
 <Heading children=[<RawText children='5.1 Anatomy Overview'>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<RawText children='| System | Main Organs | Function |'>,
 <LineBreak children='\n'>,
 <RawText children='|--------|------------|----------|'>,
 <LineBreak children='\n'>,
 <RawText children='| '>,
 <StrongEmphasis children=[<RawText children='Male'>]>,
 <RawText children=' | Testes, epididymis, vas deferens, penis | Produce and deliver sperm. |'>,
 <LineBreak children='\n'>,
 <RawText children='| '>,
 <StrongEmphasis children=[<RawText children='Female'>]>,
 <RawText children=(' | Ovaries, fallopian tubes, uterus, vagina | Produce eggs, provide site for '
 'fertilization and fetal development. |')>]>,
 <BlankLine children=[]>,
 <Heading children=[<RawText children='5.2 The Menstrual Cycle (28‑day Overview)'>]>,
 <BlankLine children=[]>,
 <List children=[<ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='Menstruation (Days 1‑5)'>]>,
 <RawText children=' – Shedding of uterine lining.  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='Follicular Phase (Days 1‑13)'>]>,
 <RawText children=' – Follicles mature; estrogen rises.  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='Ovulation (Day 14)'>]>,
 <RawText children=' – Release of a mature egg from the ovary.  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='Luteal Phase (Days 15‑28)'>]>,
 <RawText children=(' – Corpus luteum secretes progesterone; prepares uterus for possible '
 'implantation.  ')>]>]>]>,
 <BlankLine children=[]>,
 <Heading children=[<RawText children='5.3 Fertilization & Early Development'>]>,
 <BlankLine children=[]>,
 <List children=[<ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='Fertilization'>]>,
 <RawText children=' occurs in the '>,
 <StrongEmphasis children=[<RawText children='ampulla'>]>,
 <RawText children=' of the fallopian tube.  '>]>]>,
 <ListItem children=[<Paragraph children=[<RawText children='The resulting '>,
 <StrongEmphasis children=[<RawText children='zygote'>]>,
 <RawText children=' undergoes '>,
 <StrongEmphasis children=[<RawText children='cleavage'>]>,
 <RawText children=' (cell division) while traveling to the uterus.  '>]>]>,
 <ListItem children=[<Paragraph children=[<RawText children='By day 5–6, a '>,
 <StrongEmphasis children=[<RawText children='blastocyst'>]>,
 <RawText children=' implants into the uterine lining.  '>]>]>]>,
 <BlankLine children=[]>,
 <Heading children=[<RawText children='5.4 Key Facts for 8th Graders'>]>,
 <BlankLine children=[]>,
 <List children=[<ListItem children=[<Paragraph children=[<RawText children='Humans have '>,
 <StrongEmphasis children=[<RawText children='23 pairs of chromosomes'>]>,
 <RawText children=' (46 total).  '>]>]>,
 <ListItem children=[<Paragraph children=[<RawText children='Each parent contributes '>,
 <StrongEmphasis children=[<RawText children='one set'>]>,
 <RawText children=' (23 chromosomes).  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='Genetic disorders'>]>,
 <RawText children=(' can arise from abnormal chromosome numbers (e.g., Down syndrome – trisomy '
 '21).  ')>]>]>]>,
 <BlankLine children=[]>,
 <ThematicBreak children=[]>,
 <BlankLine children=[]>,
 <Heading children=[<RawText children='6. Genetic Variation and Its Importance'>]>,
 <BlankLine children=[]>,
 <Heading children=[<RawText children='6.1 Sources of Variation'>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<RawText children='| Source | Description |'>,
 <LineBreak children='\n'>,
 <RawText children='|--------|-------------|'>,
 <LineBreak children='\n'>,
 <RawText children='| '>,
 <StrongEmphasis children=[<RawText children='Crossing‑over'>]>,
 <RawText children=' (during meiosis) | Exchange of DNA between homologous chromosomes. |'>,
 <LineBreak children='\n'>,
 <RawText children='| '>,
 <StrongEmphasis children=[<RawText children='Independent Assortment'>]>,
 <RawText children=' | Random distribution of maternal and paternal chromosomes to gametes. |'>,
 <LineBreak children='\n'>,
 <RawText children='| '>,
 <StrongEmphasis children=[<RawText children='Random Fertilization'>]>,
 <RawText children=' | Any sperm can fertilize any egg, creating many possible combinations. |'>,
 <LineBreak children='\n'>,
 <RawText children='| '>,
 <StrongEmphasis children=[<RawText children='Mutations'>]>,
 <RawText children=' | Changes in DNA sequence; can be beneficial, neutral, or harmful. |'>]>,
 <BlankLine children=[]>,
 <Heading children=[<RawText children='6.2 Why Variation Matters'>]>,
 <BlankLine children=[]>,
 <List children=[<ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='Adaptation:'>]>,
 <RawText children=' Populations with diverse traits can survive changing environments.  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='Evolution:'>]>,
 <RawText children=' Natural selection acts on variation, leading to new species over time.  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='Health:'>]>,
 <RawText children=' Genetic diversity reduces the spread of inherited diseases.  '>]>]>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<StrongEmphasis children=[<RawText children='Key Fact:'>]>,
 <RawText children=(' Identical twins are natural examples of asexual reproduction in humans '
 '(they develop from the same fertilized egg that split early).  ')>]>,
 <BlankLine children=[]>,
 <ThematicBreak children=[]>,
 <BlankLine children=[]>,
 <Heading children=[<RawText children='Summary'>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<RawText children='Reproduction is the cornerstone of life, occurring through '>,
 <StrongEmphasis children=[<RawText children='asexual'>]>,
 <RawText children=' (cloning) or '>,
 <StrongEmphasis children=[<RawText children='sexual'>]>,
 <RawText children=(' (gamete fusion) mechanisms. Asexual reproduction offers speed but little '
 'genetic diversity, while sexual reproduction—found in most plants and '
 'animals—generates variation essential for evolution. In plants, pollination, '
 'fertilization, and seed formation link the male and female structures of '
 'flowers. Animals display a wide range of reproductive strategies, from '
 'external fertilization in fish to internal gestation in mammals. Human '
 'reproduction follows a well‑coordinated hormonal cycle, culminating in '
 'fertilization, implantation, and development. Understanding the sources of '
 'genetic variation (crossing‑over, independent assortment, random '
 'fertilization, mutations) explains how species adapt and evolve.')>]>,
 <BlankLine children=[]>,
 <ThematicBreak children=[]>,
 <BlankLine children=[]>,
 <Heading children=[<RawText children='Sample Test (8th Grade)'>]>,
 <BlankLine children=[]>,
 <Heading children=[<RawText children='Part A – Multiple Choice (Choose the best answer)'>]>,
 <BlankLine children=[]>,
 <List children=[<ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='Which of the following is '>,
 <Emphasis children=[<RawText children='not'>]>,
 <RawText children=' a form of asexual reproduction?'>]>,
 <LineBreak children='\n'>,
 <RawText children='a) Binary fission'>,
 <LineBreak children='\n'>,
 <RawText children='b) Budding'>,
 <LineBreak children='\n'>,
 <RawText children='c) Pollination'>,
 <LineBreak children='\n'>,
 <RawText children='d) Fragmentation  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='In flowering plants, the structure that produces pollen is the:'>]>,
 <LineBreak children='\n'>,
 <RawText children='a) Pistil'>,
 <LineBreak children='\n'>,
 <RawText children='b) Stamen'>,
 <LineBreak children='\n'>,
 <RawText children='c) Ovary'>,
 <LineBreak children='\n'>,
 <RawText children='d) Sepal  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='External fertilization is most common in:'>]>,
 <LineBreak children='\n'>,
 <RawText children='a) Mammals'>,
 <LineBreak children='\n'>,
 <RawText children='b) Birds'>,
 <LineBreak children='\n'>,
 <RawText children='c) Fish and amphibians'>,
 <LineBreak children='\n'>,
 <RawText children='d) Reptiles  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='During meiosis, crossing‑over occurs in which phase?'>]>,
 <LineBreak children='\n'>,
 <RawText children='a) Prophase I'>,
 <LineBreak children='\n'>,
 <RawText children='b) Metaphase I'>,
 <LineBreak children='\n'>,
 <RawText children='c) Anaphase II'>,
 <LineBreak children='\n'>,
 <RawText children='d) Telophase I  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='The hormone that prepares the uterus for implantation after ovulation is:'>]>,
 <LineBreak children='\n'>,
 <RawText children='a) Estrogen'>,
 <LineBreak children='\n'>,
 <RawText children='b) Progesterone'>,
 <LineBreak children='\n'>,
 <RawText children='c) Testosterone'>,
 <LineBreak children='\n'>,
 <RawText children='d) Luteinizing hormone  '>]>]>]>,
 <BlankLine children=[]>,
 <Heading children=[<RawText children='Part B – True / False (Mark T or F)'>]>,
 <BlankLine children=[]>,
 <List children=[<ListItem children=[<Paragraph children=[<RawText children=('___ All offspring produced by asexual reproduction are genetically identical '
 'to the parent.  ')>]>]>,
 <ListItem children=[<Paragraph children=[<RawText children=('___ In ovoviviparous animals, the embryo receives nutrients directly from '
 'the mother’s blood supply.  ')>]>]>,
 <ListItem children=[<Paragraph children=[<RawText children='___ The human male contributes 23 chromosomes to the zygote.  '>]>]>,
 <ListItem children=[<Paragraph children=[<RawText children='___ Spores are a type of gamete.  '>]>]>,
 <ListItem children=[<Paragraph children=[<RawText children='___ Genetic variation can arise from random fertilization.  '>]>]>]>,
 <BlankLine children=[]>,
 <Heading children=[<RawText children='Part C – Short Answer (2–3 sentences)'>]>,
 <BlankLine children=[]>,
 <List children=[<ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children=('Explain why genetic variation is important for a population’s long‑term '
 'survival.')>]>,
 <RawText children='  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='Describe the main steps of the menstrual cycle that lead to ovulation.'>]>,
 <RawText children='  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children=('Give one example of a plant that reproduces asexually and explain the method '
 'it uses.')>]>,
 <RawText children='  '>]>]>]>,
 <BlankLine children=[]>,
 <Heading children=[<RawText children='Answer Key (for teacher use)'>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<RawText children='| # | Answer |'>,
 <LineBreak children='\n'>,
 <RawText children='|---|--------|'>,
 <LineBreak children='\n'>,
 <RawText children='| 1 | c) Pollination |'>,
 <LineBreak children='\n'>,
 <RawText children='| 2 | b) Stamen |'>,
 <LineBreak children='\n'>,
 <RawText children='| 3 | c) Fish and amphibians |'>,
 <LineBreak children='\n'>,
 <RawText children='| 4 | a) Prophase I |'>,
 <LineBreak children='\n'>,
 <RawText children='| 5 | b) Progesterone |'>,
 <LineBreak children='\n'>,
 <RawText children='| 6 | T |'>,
 <LineBreak children='\n'>,
 <RawText children='| 7 | F (embryo is nourished by yolk, not directly by mother) |'>,
 <LineBreak children='\n'>,
 <RawText children='| 8 | T |'>,
 <LineBreak children='\n'>,
 <RawText children='| 9 | F (spores are reproductive cells but not gametes) |'>,
 <LineBreak children='\n'>,
 <RawText children='|10 | T |'>,
 <LineBreak children='\n'>,
 <RawText children='|11| '>,
 <Emphasis children=[<RawText children='Sample:'>]>,
 <RawText children=(' Variation provides a pool of different traits; when environments change, '
 'some individuals may possess advantageous traits that allow the population '
 'to adapt and avoid extinction. |')>,
 <LineBreak children='\n'>,
 <RawText children='|12| '>,
 <Emphasis children=[<RawText children='Sample:'>]>,
 <RawText children=(' The follicular phase (days 1‑13) sees estrogen rise and a follicle mature; '
 'ovulation (day 14) releases the egg; the luteal phase (days 15‑28) produces '
 'progesterone to thicken the uterine lining for possible implantation. |')>,
 <LineBreak children='\n'>,
 <RawText children='|13| '>,
 <Emphasis children=[<RawText children='Sample:'>]>,
 <RawText children=' Strawberries reproduce asexually via '>,
 <StrongEmphasis children=[<RawText children='runners'>]>,
 <RawText children=(' (stolons); a runner grows horizontally, roots at nodes, and forms a new '
 'plant genetically identical to the parent. |')>]>,
 <BlankLine children=[]>,
