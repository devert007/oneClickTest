 <ListItem children=[<Paragraph children=[<RawText children='External fertilization is most common in:'>,
 <LineBreak children='\n'>,
 <RawText children='a) Mammals'>,
 <LineBreak children='\n'>,
 <RawText children='b) Birds'>,
 <LineBreak children='\n'>,
 <RawText children='c) Fish'>,
 <LineBreak children='\n'>,
 <RawText children='d) Reptiles  '>]>]>,
 <ListItem children=[<Paragraph children=[<RawText children='The hormone that directly stimulates ovulation in females is:'>,
 <LineBreak children='\n'>,
 <RawText children='a) FSH'>,
 <LineBreak children='\n'>,
 <RawText children='b) LH'>,
 <LineBreak children='\n'>,
 <RawText children='c) Progesterone'>,
 <LineBreak children='\n'>,
 <RawText children='d) Estrogen  '>]>]>,
 <ListItem children=[<Paragraph children=[<RawText children='Parthenogenesis is best described as:'>,
 <LineBreak children='\n'>,
 <RawText children='a) Fertilization of an egg by two sperm cells.'>,
 <LineBreak children='\n'>,
 <RawText children='b) Development of an embryo from an unfertilized egg.'>,
 <LineBreak children='\n'>,
 <RawText children='c) Fusion of gametes from two different species.'>,
 <LineBreak children='\n'>,
 <RawText children='d) Asexual reproduction by fragmentation.  '>]>]>,
 <ListItem children=[<Paragraph children=[<RawText children=('Which pollination vector is most likely for a plant with large, scented, '
 'night‑blooming flowers?')>,
 <LineBreak children='\n'>,
 <RawText children='a) Wind'>,
 <LineBreak children='\n'>,
 <RawText children='b) Bees'>,
 <LineBreak children='\n'>,
 <RawText children='c) Bats'>,
 <LineBreak children='\n'>,
 <RawText children='d) Water  '>]>]>,
 <ListItem children=[<Paragraph children=[<RawText children='The primary function of the '>,
 <StrongEmphasis children=[<RawText children='prostate gland'>]>,
 <RawText children=' is to:'>,
 <LineBreak children='\n'>,
 <RawText children='a) Produce sperm.'>,
 <LineBreak children='\n'>,
 <RawText children='b) Store sperm.'>,
 <LineBreak children='\n'>,
 <RawText children='c) Secrete fluid that nourishes sperm.'>,
 <LineBreak children='\n'>,
 <RawText children='d) Release hormones that trigger puberty.  '>]>]>,
 <ListItem children=[<Paragraph children=[<RawText children=('In mammals, the structure that provides nutrients to the developing embryo '
 'is the:')>,
 <LineBreak children='\n'>,
 <RawText children='a) Amnion'>,
 <LineBreak children='\n'>,
 <RawText children='b) Chorion'>,
 <LineBreak children='\n'>,
 <RawText children='c) Placenta'>,
 <LineBreak children='\n'>,
 <RawText children='d) Yolk sac  '>]>]>,
 <ListItem children=[<Paragraph children=[<RawText children='Which of the following statements about genetic variation is '>,
 <StrongEmphasis children=[<RawText children='true'>]>,
 <RawText children='?'>,
 <LineBreak children='\n'>,
 <RawText children='a) Asexual reproduction generates more variation than sexual reproduction.'>,
 <LineBreak children='\n'>,
 <RawText children='b) Crossing over occurs during meiosis in both asexual and sexual organisms.'>,
 <LineBreak children='\n'>,
 <RawText children='c) Sexual reproduction creates new allele combinations each generation.'>,
 <LineBreak children='\n'>,
 <RawText children=('d) Mutations are the only source of variation in sexually reproducing '
 'species.  ')>]>]>,
 <ListItem children=[<Paragraph children=[<RawText children='The “Red Queen” hypothesis explains why:'>,
 <LineBreak children='\n'>,
 <RawText children='a) Asexual organisms dominate in stable environments.'>,
 <LineBreak children='\n'>,
 <RawText children='b) Sexual reproduction persists despite its high energy cost.'>,
 <LineBreak children='\n'>,
 <RawText children='c) Some species can switch between reproductive modes.'>,
 <LineBreak children='\n'>,
 <RawText children='d) Parental care is essential for offspring survival.  '>]>]>]>,
 <BlankLine children=[]>,
 <Heading children=[<RawText children='Part B – True / False (1 point each)'>]>,
 <BlankLine children=[]>,
 <List children=[<ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='True / False'>]>,
 <RawText children=' – In humans, each ovary releases one mature egg per menstrual cycle.  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='True / False'>]>,
 <RawText children=' – Budding in hydra results in a genetically identical offspring.  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='True / False'>]>,
 <RawText children=(' – The male gamete (sperm) contributes more cytoplasm to the zygote than the '
 'female gamete (egg).  ')>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='True / False'>]>,
 <RawText children=' – Double fertilization occurs in all seed plants.  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='True / False'>]>,
 <RawText children=' – Ovoviviparous sharks provide nutrients to embryos via a placenta.  '>]>]>]>,
 <BlankLine children=[]>,
 <Heading children=[<RawText children='Part C – Short Answer (3 points each)'>]>,
 <BlankLine children=[]>,
 <List children=[<ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='Define'>]>,
 <RawText children=' “binary fission” and give an example of an organism that uses this method.  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='Explain'>]>,
 <RawText children=' the role of the pollen tube in angiosperm fertilization.  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='List'>]>,
 <RawText children=' three advantages and two disadvantages of sexual reproduction.  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='Describe'>]>,
 <RawText children=(' the hormonal changes that occur during the luteal phase of the menstrual '
 'cycle.  ')>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='Compare'>]>,
 <RawText children=(' external and internal fertilization in terms of environmental requirements '
 'and offspring survival.  ')>]>]>]>,
 <BlankLine children=[]>,
 <Heading children=[<RawText children='Part D – Diagram Labeling (5 points)'>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<Emphasis children=[<RawText children=('Provide a blank diagram of a human female reproductive system (or a '
 'flowering plant). Students must correctly label at least six structures '
 '(e.g., ovary, fallopian tube, uterus, cervix, vagina, or stamen, pistil, '
 'anther, stigma, ovary).')>]>]>,
