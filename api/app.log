 <ListItem children=[<Paragraph children=[<RawText children='Координаты фокуса;  '>]>]>,
 <ListItem children=[<Paragraph children=[<RawText children='Уравнение директрисы.  '>]>]>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<StrongEmphasis children=[<RawText children='Решение'>]>,
 <RawText children='  '>]>,
 <BlankLine children=[]>,
 <List children=[<ListItem children=[<Paragraph children=[<RawText children='Приведём к вершинной форме:  '>]>]>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<Literal children='['>,
 <LineBreak children='\n'>,
 <RawText children='a=-\\frac14,'>,
 <Literal children=';'>,
 <RawText children=' b=5,'>,
 <Literal children=';'>,
 <RawText children=' c=-6.'>,
 <LineBreak children='\n'>,
 <RawText children=('x_{0}= -\\frac{b}{2a}= -\\frac{5}{2\\cdot(-\\frac14)} = -\\frac{5}{- '
 '\\frac12}=10.')>,
 <LineBreak children='\n'>,
 <RawText children=('y_{0}=c-\\frac{b^{2}}{4a}= -6-\\frac{25}{4\\cdot(-\\frac14)} = '
 '-6-\\frac{25}{-1}=19.')>,
 <LineBreak children='\n'>,
 <Literal children=']'>,
 <RawText children='  '>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<RawText children='Вершина '>,
 <Literal children='('>,
 <RawText children='(10,19)'>,
 <Literal children=')'>,
 <RawText children='.  '>]>,
 <BlankLine children=[]>,
 <List children=[<ListItem children=[<Paragraph children=[<Literal children='('>,
 <RawText children='p=\\frac{1}{4a}= \\frac{1}{4\\cdot(-\\frac14)} = -1'>,
 <Literal children=')'>,
 <RawText children='.  '>]>]>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<RawText children='Фокус: '>,
 <Literal children='('>,
 <RawText children='(x_{0},'>,
 <Literal children=','>,
 <RawText children='y_{0}+p) = (10,'>,
 <Literal children=','>,
 <RawText children='19-1) = (10,18)'>,
 <Literal children=')'>,
 <RawText children='.  '>]>,
 <BlankLine children=[]>,
 <List children=[<ListItem children=[<Paragraph children=[<RawText children='Директриса: '>,
 <Literal children='('>,
 <RawText children='y = y_{0}-p = 19+1 = 20'>,
 <Literal children=')'>,
 <RawText children='.  '>]>]>]>,
 <BlankLine children=[]>,
 <Heading children=[<RawText children='5.2 Пересечение параболы с прямой'>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<StrongEmphasis children=[<RawText children='Вопрос'>]>,
 <LineBreak children='\n'>,
 <RawText children='Сколько точек пересечения имеет парабола '>,
 <Literal children='('>,
 <RawText children='y = x^{2} - 4x + 3'>,
 <Literal children=')'>,
 <RawText children=' и прямая '>,
 <Literal children='('>,
 <RawText children='y = 2x - 1'>,
 <Literal children=')'>,
 <RawText children='?  '>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<StrongEmphasis children=[<RawText children='Решение'>]>,
 <RawText children='  '>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<RawText children='Приравниваем:  '>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<Literal children='['>,
 <LineBreak children='\n'>,
 <RawText children='x^{2} - 4x + 3 = 2x - 1 '>,
 <Literal children=';'>,
 <RawText children='\\Rightarrow'>,
 <Literal children=';'>,
 <RawText children=' x^{2} - 6x + 4 = 0.'>,
 <LineBreak children='\n'>,
 <Literal children=']'>,
 <RawText children='  '>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<RawText children='Дискриминант '>,
 <Literal children='('>,
 <RawText children='D = (-6)^{2} - 4\\cdot1\\cdot4 = 36 - 16 = 20 > 0'>,
 <Literal children=')'>,
 <RawText children='.  '>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<RawText children='Следовательно, две точки пересечения.  '>]>,
 <BlankLine children=[]>,
 <Heading children=[<RawText children='5.3 Применение свойства фокуса'>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<StrongEmphasis children=[<RawText children='Вопрос'>]>,
 <LineBreak children='\n'>,
 <RawText children='Точка '>,
 <Literal children='('>,
 <RawText children='M(2,5)'>,
 <Literal children=')'>,
 <RawText children=' лежит на параболе с фокусом '>,
 <Literal children='('>,
 <RawText children='F(0,2)'>,
 <Literal children=')'>,
 <RawText children=' и директрисой '>,
 <Literal children='('>,
 <RawText children='y=-2'>,
 <Literal children=')'>,
 <RawText children='. Найдите уравнение этой параболы.  '>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<StrongEmphasis children=[<RawText children='Решение'>]>,
 <RawText children='  '>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<RawText children='Расстояние '>,
 <Literal children='('>,
 <RawText children='MF = \\sqrt{(2-0)^{2}+(5-2)^{2}} = \\sqrt{4+9}= \\sqrt{13}'>,
 <Literal children=')'>,
 <RawText children='.  '>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<RawText children='Расстояние от '>,
 <Literal children='('>,
 <RawText children='M'>,
 <Literal children=')'>,
 <RawText children=' до директрисы: '>,
 <Literal children='('>,
 <RawText children='|5-(-2)| = 7'>,
 <Literal children=')'>,
 <RawText children='.  '>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<RawText children='Для параболы расстояния должны быть равны, но '>,
 <Literal children='('>,
 <RawText children='\\sqrt{13}\\neq7'>,
 <Literal children=')'>,
 <RawText children='. Ошибка в условии?  '>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<RawText children=('(В реальном тесте такие задачи проверяют умение записать уравнение через '
 'условие равенства расстояний.)  ')>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<StrongEmphasis children=[<RawText children='Уравнение'>]>,
 <RawText children=' (по определению):  '>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<Literal children='['>,
 <LineBreak children='\n'>,
 <RawText children='\\sqrt{(x-0)^{2}+(y-2)^{2}} = |y+2|.'>,
 <LineBreak children='\n'>,
 <Literal children=']'>,
 <RawText children='  '>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<RawText children='Возводим в квадрат:  '>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<Literal children='['>,
 <LineBreak children='\n'>,
 <RawText children='x^{2} + (y-2)^{2} = (y+2)^{2} '>,
 <Literal children=';'>,
 <RawText children='\\Rightarrow'>,
 <Literal children=';'>,
 <RawText children=' x^{2} + y^{2} -4y +4 = y^{2}+4y+4.'>,
 <LineBreak children='\n'>,
 <Literal children=']'>,
 <RawText children='  '>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<RawText children='Сокращаем '>,
 <Literal children='('>,
 <RawText children='y^{2}'>,
 <Literal children=')'>,
 <RawText children=' и 4:  '>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<Literal children='['>,
 <LineBreak children='\n'>,
 <RawText children='x^{2} -4y = 4y '>,
 <Literal children=';'>,
 <RawText children='\\Rightarrow'>,
 <Literal children=';'>,
 <RawText children=' x^{2}=8y '>,
 <Literal children=';'>,
 <RawText children='\\Rightarrow'>,
 <Literal children=';'>,
 <RawText children=' y = \\frac{x^{2}}{8}.'>,
 <LineBreak children='\n'>,
 <Literal children=']'>,
 <RawText children='  '>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<RawText children='Парабола открыта вверх, вершина в начале координат.  '>]>,
 <BlankLine children=[]>,
 <Heading children=[<RawText children='5.4 Тестовые задания (вариант)'>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<RawText children='| № | Задание | Краткий ответ |'>,
 <LineBreak children='\n'>,
 <RawText children='|---|---|---|'>,
 <LineBreak children='\n'>,
 <RawText children='| 1 | Запишите уравнение параболы, вершина которой '>,
 <Literal children='('>,
 <RawText children='(-2,3)'>,
 <Literal children=')'>,
 <RawText children=', а параметр '>,
 <Literal children='('>,
 <RawText children='p=1'>,
 <Literal children=')'>,
 <RawText children='. | '>,
 <Literal children='('>,
 <RawText children='y-3 = \\frac{1}{4}(x+2)^{2}'>,
 <Literal children=')'>,
 <RawText children=' → '>,
 <Literal children='('>,
 <RawText children='y = \\frac{1}{4}(x+2)^{2}+3'>,
 <Literal children=')'>,
 <RawText children='. |'>,
 <LineBreak children='\n'>,
 <RawText children='| 2 | Найдите координаты фокуса параболы '>,
 <Literal children='('>,
 <RawText children='y = -\\frac{1}{2}x^{2}+4'>,
 <Literal children=')'>,
 <RawText children='. | Вершина '>,
 <Literal children='('>,
 <RawText children='(0,4)'>,
 <Literal children=')'>,
 <RawText children=', '>,
 <Literal children='('>,
 <RawText children='p = \\frac{1}{4a}= \\frac{1}{4\\cdot(-\\frac12)} = -\\frac12'>,
 <Literal children=')'>,
 <RawText children='. Фокус '>,
 <Literal children='('>,
 <RawText children='(0,4-\\frac12) = (0,3.5)'>,
 <Literal children=')'>,
 <RawText children='. |'>,
 <LineBreak children='\n'>,
 <RawText children='| 3 | Сколько точек пересечения у графиков '>,
 <Literal children='('>,
 <RawText children='y = x^{2}'>,
 <Literal children=')'>,
 <RawText children=' и '>,
 <Literal children='('>,
 <RawText children='y = -x^{2}+6'>,
 <Literal children=')'>,
 <RawText children='? | Приравниваем: '>,
 <Literal children='('>,
 <RawText children='x^{2} = -x^{2}+6 \\Rightarrow 2x^{2}=6 \\Rightarrow x^{2}=3'>,
 <Literal children=')'>,
 <RawText children='. Два корня → 2 точки. |'>,
 <LineBreak children='\n'>,
 <RawText children='| 4 | Парабола проходит через точки '>,
 <Literal children='('>,
 <RawText children='(0,0)'>,
 <Literal children=')'>,
 <RawText children=', '>,
 <Literal children='('>,
 <RawText children='(2,4)'>,
 <Literal children=')'>,
 <RawText children=' и '>,
 <Literal children='('>,
 <RawText children='(4,0)'>,
 <Literal children=')'>,
 <RawText children='. Найдите её уравнение. | Подставляем в форму '>,
 <Literal children='('>,
 <RawText children='y = ax^{2}+bx+c'>,
 <Literal children=')'>,
 <RawText children='. Система: '>,
 <Literal children='('>,
 <RawText children='c=0'>,
 <Literal children=')'>,
 <RawText children='; '>,
 <Literal children='('>,
 <RawText children='4 = 4a+2b'>,
 <Literal children=')'>,
 <RawText children='; '>,
 <Literal children='('>,
 <RawText children='0 = 16a+4b'>,
 <Literal children=')'>,
 <RawText children='. Решаем → '>,
 <Literal children='('>,
 <RawText children='a=-\\frac12,'>,
 <Literal children=';'>,
 <RawText children=' b=2'>,
 <Literal children=')'>,
 <RawText children='. Уравнение: '>,
 <Literal children='('>,
 <RawText children='y = -\\frac12 x^{2}+2x'>,
 <Literal children=')'>,
 <RawText children='. |'>,
 <LineBreak children='\n'>,
 <RawText children='| 5 | Укажите уравнение директрисы параболы '>,
 <Literal children='('>,
 <RawText children='y = 3(x-1)^{2}+2'>,
 <Literal children=')'>,
 <RawText children='. | Вершина '>,
 <Literal children='('>,
 <RawText children='(1,2)'>,
 <Literal children=')'>,
 <RawText children=', '>,
 <Literal children='('>,
 <RawText children='a=3'>,
 <Literal children=')'>,
 <RawText children=' → '>,
 <Literal children='('>,
 <RawText children='p = \\frac{1}{4a}= \\frac{1}{12}'>,
 <Literal children=')'>,
 <RawText children='. Директриса: '>,
 <Literal children='('>,
 <RawText children='y = y_{0}-p = 2-\\frac{1}{12}= \\frac{23}{12}'>,
 <Literal children=')'>,
 <RawText children='. |'>]>,
 <BlankLine children=[]>,
 <ThematicBreak children=[]>,
 <BlankLine children=[]>,
 <Heading children=[<RawText children='Краткое резюме'>]>,
 <BlankLine children=[]>,
 <List children=[<ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='Определение'>]>,
 <RawText children=': парабола – множество точек, равноудалённых от фокуса и директрисы.  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='Уравнение'>]>,
 <RawText children=': в общей форме '>,
 <Literal children='('>,
 <RawText children='y=ax^{2}+bx+c'>,
 <Literal children=')'>,
 <RawText children='; в вершиной – '>,
 <Literal children='('>,
 <RawText children='y=a(x-x_{0})^{2}+y_{0}'>,
 <Literal children=')'>,
 <RawText children='.  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='Параметры'>]>,
 <RawText children=': '>,
 <Literal children='('>,
 <RawText children='p=\\frac{1}{4a}'>,
 <Literal children=')'>,
 <RawText children=' (расстояние от вершины до фокуса и директрисы); фокус '>,
 <Literal children='('>,
 <RawText children='(x_{0},y_{0}+p)'>,
 <Literal children=')'>,
 <RawText children=', директриса '>,
 <Literal children='('>,
 <RawText children='y=y_{0}-p'>,
 <Literal children=')'>,
 <RawText children='.  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='Преобразования'>]>,
 <RawText children=': сдвиг, растяжение/сжатие, отражение (знак '>,
 <Literal children='('>,
 <RawText children='a'>,
 <Literal children=')'>,
 <RawText children=').  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='Типовые задачи'>]>,
 <RawText children=(': нахождение вершины, фокуса, директрисы; пересечение с прямой; построение '
 'уравнения по заданным точкам; использование свойства равенства расстояний.  ')>]>]>]>,
 <BlankLine children=[]>,
 <Paragraph children=[<RawText children=('Эти сведения позволяют сформировать тест из вопросов разного уровня '
 'сложности: от простых вычислений до задач на построение уравнения по '
 'геометрическим условиям. При составлении теста рекомендуется включить:')>]>,
 <BlankLine children=[]>,
 <List children=[<ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='Теоретические'>]>,
 <RawText children=' вопросы (определения, формулы).  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='Расчётные'>]>,
 <RawText children=' задачи (найти вершину, фокус, директрису).  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='Применительные'>]>,
 <RawText children=' задачи (пересечение с прямой, построение уравнения).  '>]>]>,
 <ListItem children=[<Paragraph children=[<StrongEmphasis children=[<RawText children='Творческие'>]>,
 <RawText children=' задания (описать преобразования графика).  '>]>]>]>,
